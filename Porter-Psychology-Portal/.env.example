# MySQL credentials. URL-encode special characters in username/password.
DATABASE_URL=mysql://user:password@mysql-host.example.com:3306/defaultdb

# Paste the Aiven CA certificate as a multiline value in the hosting dashboard.
# Escaped newlines (-----BEGIN CERTIFICATE-----\n...) are also accepted.
MYSQL_CA_CERT=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Lara Akinpelu
ADMIN_TIMEZONE=America/Vancouver
DB_CONNECTION_LIMIT=5

# Local runtime settings
PORT=8080
NODE_ENV=development
SEED_DEMO_DATA=false

# Transactional email
RESEND_API_KEY=
# Example after domain verification: Porter Psychology <appointments@updates.yourdomain.com>
EMAIL_FROM=
PRACTITIONER_NOTIFICATION_EMAIL=
APP_URL=http://localhost:22912

# Stripe Checkout (use test-mode values during verification)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upheal and security
UPHEAL_MEETING_URL=
CRON_SECRET=replace-with-a-long-random-value
SESSION_IDLE_MINUTES=10
